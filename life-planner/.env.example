# Copy to .env and fill in. Never commit .env.

# Long random string. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PLANNER_TOKEN=

# ntfy topic for push notifications. Anyone who knows it can read your notifications on the
# public ntfy.sh server, so make it long and random (or self-host ntfy and set NTFY_URL).
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

# Your public hostname: planner.yourdomain (homelab route) or old-laptop.tail1234.ts.net (Tailscale Funnel).
# Comma-separated if several.
# When this is set, PLANNER_TOKEN is required or the app won't start.
PUBLIC_HOSTS=

DIGEST_TIME=08:00
REMINDER_OFFSETS_HOURS=24,2
