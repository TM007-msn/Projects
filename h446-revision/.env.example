# Copy to .env and fill in. Never commit .env.

# Port the app listens on (inside and outside the container).
PORT=8000

# Generate with:  docker compose run --rm app python -m app.hashpw
# (or locally:    python -m app.hashpw)
APP_PASSWORD_HASH=

# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Set to true only if you put the app behind HTTPS.
COOKIE_SECURE=false

# Days before you have to log in again.
SESSION_DAYS=30
